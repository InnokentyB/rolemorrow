# Local synthetic demo works with no credentials.
PORT=3027
# Live mode is intentionally opt-in; do not enable without owner authorization.
ALLOW_LIVE=0
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Set an exact available NVIDIA model ID from your Token Factory project.
NEBIUS_MODEL=

# Optional bounded live run: 1 to 20 assessed listings per company (default 20).
LIVE_MAX_JOBS_PER_COMPANY=20

# Optional stronger NVIDIA model for assessment; defaults to NEBIUS_MODEL.
NEBIUS_ASSESSMENT_MODEL=
