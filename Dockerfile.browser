FROM node:24.22.0-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-liberation && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN chmod 0644 package.json package-lock.json && npm ci --ignore-scripts --no-audit --no-fund
COPY --chown=node:node app ./app
COPY --chown=node:node public ./public
COPY --chown=node:node tests ./tests
COPY --chown=node:node ops ./ops
RUN mkdir -p /app/artifacts /app/.impeccable/review && chown -R node:node /app/artifacts /app/.impeccable
USER node
ENV CHROMIUM_PATH=/usr/bin/chromium
CMD ["npm", "run", "test:e2e"]
